{
  "name": "saqr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "audit": "npm audit --omit=dev --audit-level=high",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then if [ -n \"$DATABASE_URL\" ]; then DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" prisma migrate deploy && DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" tsx prisma/seed.ts && { if [ \"$PREVIEW_MODE\" = \"true\" ] && [ -n \"$DEMO_PASSWORD\" ]; then DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" tsx scripts/seed-demo.ts || echo \"WARNING: demo accounts were not created\"; fi; }; else echo \"WARNING: DATABASE_URL is not set, skipping migrations. Set it in Vercel Environment Variables and redeploy.\"; fi; fi && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "clsx": "^2.1.1",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "deepmerge-ts": "^8.0.0"
  }
}
