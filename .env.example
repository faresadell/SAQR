# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://saqr:saqr_dev_password@localhost:5432/saqr"
APP_URL="http://localhost:3000"

# Generate each with: openssl rand -base64 48   (SESSION_SECRET)
#                     openssl rand -base64 32   (DATA_ENCRYPTION_KEY, exactly 32 bytes)
SESSION_SECRET=""
DATA_ENCRYPTION_KEY=""

# "console" prints OTP codes to the server log (development ONLY, refused in production).
# "disabled" sends nothing. A real SMS/WhatsApp provider is added in a later phase.
OTP_PROVIDER="console"

# Set to "true" ONLY behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY="false"
